---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Observatorio en español de plazos y obligaciones regulatorias para tecnología médica e IA clínica: MDR, IVDR, AI Act y FDA QMSR.' } = Astro.props;

const nav = [
  { href: '/', label: 'Cronología' },
  { href: '/ia-clinica', label: 'IA clínica' },
  { href: '/guias', label: 'Guías MDCG' },
  { href: '/obligaciones', label: 'Obligaciones' },
  { href: '/organismos-notificados', label: 'Organismos notificados' },
  { href: '/comparador-eqms', label: 'Comparador eQMS' },
  { href: '/espana', label: 'España' },
  { href: '/glosario', label: 'Glosario' },
  { href: '/fuentes', label: 'Fuentes' },
  { href: '/newsletter', label: 'Newsletter' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Radar MDR × AI Act</title>
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido principal</a>
    <header class="cabecera">
      <div class="contenedor cabecera-inner">
        <a class="logo" href="/">Radar <span aria-hidden="true">MDR × AI Act</span><span class="visually-hidden">MDR por AI Act</span></a>
        <nav aria-label="Navegación principal">
          <ul class="nav-lista">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <p class="disclaimer">
          <strong>Aviso:</strong> la información de este sitio es divulgativa y no constituye
          asesoramiento legal ni regulatorio. Verifica siempre las fechas en la fuente oficial
          enlazada en cada dato.
        </p>
        <p>
          <a href="/cambios">Qué ha cambiado</a> · <a href="/rss.xml">RSS</a> ·
          <a href="/calendario.ics">Calendario de plazos (.ics)</a> ·
          <a href="/api/plazos.json">API JSON</a> · <a href="/buscar">Buscar</a> ·
          <a href="/pro">Radar Pro (2027)</a>
        </p>
        <p>
          © 2026 Radar MDR × AI Act · Datos y contenido bajo
          <a href="https://creativecommons.org/licenses/by/4.0/deed.es" rel="external noopener">CC BY 4.0</a>
          (cítalos con enlace) · Código MIT · <a href="/newsletter">Suscríbete al Radar quincenal</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --texto: #1f2430;
    --texto-suave: #4a5161;
    --fondo: #ffffff;
    --fondo-alt: #f4f6f9;
    --borde: #d6dbe4;
    --acento: #0b57d0;
    --mdr: #0b57d0;
    --ivdr: #00695c;
    --mdr-ivdr: #37474f;
    --ai-act: #6a1b9a;
    --qmsr: #b3261e;
    --aviso-fondo: #fdf3d7;
    --aviso-texto: #6a4a00;
    --urgente-fondo: #fbe4e2;
    --urgente-texto: #8c1d18;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--texto);
    background: var(--fondo);
    line-height: 1.6;
  }

  .contenedor { max-width: 62rem; margin: 0 auto; padding: 0 1rem; }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .salto {
    position: absolute; left: -999px; top: 0; background: var(--acento); color: #fff;
    padding: 0.5rem 1rem; z-index: 10; border-radius: 0 0 4px 0;
  }
  .salto:focus { left: 0; }

  a { color: var(--acento); }
  a:focus-visible { outline: 3px solid var(--acento); outline-offset: 2px; }

  .cabecera { border-bottom: 2px solid var(--borde); background: var(--fondo-alt); }
  .cabecera-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; padding-top: 0.75rem; padding-bottom: 0.75rem; }
  .logo { font-weight: 700; font-size: 1.15rem; text-decoration: none; color: var(--texto); }
  .nav-lista { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0; padding: 0; }
  .nav-lista a { text-decoration: none; color: var(--texto-suave); padding: 0.25rem 0; }
  .nav-lista a:hover, .nav-lista a[aria-current='page'] { color: var(--acento); text-decoration: underline; text-underline-offset: 4px; }

  main { padding: 2rem 1rem 3rem; }

  h1 { font-size: 1.75rem; line-height: 1.25; }
  h2 { margin-top: 2.5rem; }

  .pie { border-top: 2px solid var(--borde); background: var(--fondo-alt); padding: 1.5rem 0; font-size: 0.9rem; color: var(--texto-suave); }
  .disclaimer { max-width: 48rem; }

  .badge {
    display: inline-block; color: #fff; font-size: 0.75rem; font-weight: 700;
    padding: 0.1rem 0.5rem; border-radius: 999px; letter-spacing: 0.02em;
  }
  .badge-mdr { background: var(--mdr); }
  .badge-ivdr { background: var(--ivdr); }
  .badge-mdr-ivdr { background: var(--mdr-ivdr); }
  .badge-ai-act { background: var(--ai-act); }
  .badge-qmsr { background: var(--qmsr); }

  .chip {
    display: inline-block; background: var(--fondo-alt); border: 1px solid var(--borde);
    border-radius: 999px; padding: 0.05rem 0.6rem; font-size: 0.8rem; color: var(--texto-suave);
  }

  .proximamente {
    border: 2px dashed var(--borde); border-radius: 8px; padding: 1.25rem 1.5rem;
    background: var(--fondo-alt); color: var(--texto-suave); margin-top: 1.5rem;
  }
  .proximamente h2 { margin-top: 0; }
</style>

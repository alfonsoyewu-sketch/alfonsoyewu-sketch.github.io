---
// Registro de cambios autogenerado desde nota_cambio + fecha_verificacion.
// Doble uso: transparencia pública + borrador de la newsletter quincenal
// (copia las entradas desde el último envío y ya tienes el boletín).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cambios = (await getCollection('plazos'))
  .map((p) => p.data)
  .filter((p) => p.nota_cambio)
  .sort((a, b) => (a.fecha_verificacion < b.fecha_verificacion ? 1 : -1));

const formatoFecha = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title="Qué ha cambiado"
  description="Registro de cambios verificados en plazos regulatorios MDR, IVDR, AI Act y FDA QMSR, con fuente oficial y fecha de verificación."
>
  <h1>Qué ha cambiado</h1>
  <p>
    Cada entrada sale de los campos <code>nota_cambio</code> y <code>fecha_verificacion</code> de
    la base de datos del Radar. Si un dato no tiene fuente oficial y fecha de verificación, no se
    publica.
  </p>
  <ul class="lista-cambios">
    {
      cambios.map((p) => (
        <li id={p.id}>
          <p class="cambio-fecha">
            <strong>{formatoFecha.format(new Date(p.fecha_verificacion + 'T00:00:00'))}</strong> ·
            [{p.norma}] {p.descripcion_corta}
          </p>
          <p class="cambio-nota">
            {p.nota_cambio} — <a href={p.fuente_url} rel="external noopener">fuente oficial</a>
          </p>
        </li>
      ))
    }
  </ul>
  <p>
    <a href="/rss.xml">Suscríbete por RSS</a> ·
    <a href="/calendario.ics">Añade los plazos a tu calendario</a> ·
    <a href="/newsletter">Radar quincenal por email</a>
  </p>
</Base>

<style>
  .lista-cambios { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .lista-cambios li { border-bottom: 1px solid var(--borde); padding-bottom: 1rem; }
  .cambio-fecha { margin: 0 0 0.25rem; }
  .cambio-nota { margin: 0; color: var(--texto-suave); max-width: 46rem; }
</style>

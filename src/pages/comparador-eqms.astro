---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TablaEQMS from '../components/TablaEQMS.astro';

// La tabla se activa sola en cuanto herramientas.json tenga filas (S5-S6,
// tras las entrevistas). Plantilla de fila: src/data/herramientas.ejemplo.json.
const herramientas = (await getCollection('herramientas')).map((h) => h.data);
---

<Base
  title="Comparador de herramientas eQMS"
  description="Comparativa neutral de herramientas eQMS para MedTech: precio orientativo, público objetivo y módulos."
>
  <h1>Comparador de herramientas eQMS</h1>
  <p>
    Greenlight Guru, Qualio, MasterControl, Matrix Requirements, openRegulatory y más: precio
    orientativo, público objetivo y módulos (control documental, CAPA, ISO 13485, 21 CFR Part 11…).
  </p>

  {
    herramientas.length > 0 ? (
      <TablaEQMS filas={herramientas} />
    ) : (
      <>
        <p class="regla">
          <strong>Regla de neutralidad:</strong> cada celda de la comparativa exige al menos dos
          fuentes independientes (página oficial de precios del fabricante + G2/Capterra o
          consulta directa), las estimaciones se etiquetan como estimaciones y toda celda lleva su
          fecha de verificación visible. El blog de un fabricante que participa en la comparación
          puede ser <em>una</em> fuente, nunca el árbitro.
        </p>
        <div class="proximamente">
          <h2>Próximamente</h2>
          <p>
            Versión inicial con 5 herramientas prevista para agosto de 2026 — publicaremos cada
            fila solo cuando cumpla la regla de neutralidad.
          </p>
        </div>
      </>
    )
  }
</Base>

<style>
  .regla {
    border-left: 4px solid var(--acento); background: var(--fondo-alt);
    padding: 0.75rem 1rem; border-radius: 0 8px 8px 0; max-width: 46rem;
  }
</style>
